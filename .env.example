# Copy to .env.local. Requires Node.js 24. SQLite and media stay on this host.
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBSCRIPTION_KEY=replace-with-64-hex-characters
# Set true behind HTTPS in production; false for local HTTP only.
COOKIE_SECURE=false

# SMTP remains disabled until HOST and FROM are set. Never put these in NEXT_PUBLIC_*.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (typically 465); false uses mandatory STARTTLS (typically 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A single verified sender email address, without a display name.
SMTP_FROM=
# Only for a loopback test SMTP server. Keep false for real delivery.
SMTP_ALLOW_INSECURE_LOCAL=false
